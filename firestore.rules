rules_version = '2';

// =====================================================================
//  Firestore Security Rules  —  Akay Mighty Concept
//  ---------------------------------------------------------------------
//  Public visitors can READ content (so the site renders).
//  Only the authenticated admin can WRITE.
//
//  The admin user is created manually in Firebase Auth →
//  akay@concept.com (you said this is your single admin account).
//
//  Deploy from a terminal:
//      npm install -g firebase-tools
//      firebase login
//      firebase init firestore     (choose "Use an existing project"
//                                    → akaymightyconcept-6ea63)
//      firebase deploy --only firestore:rules
//  OR paste these rules directly into the Firebase console:
//      Firestore Database → Rules tab → paste → Publish
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- public read, admin-only write for all content ----
    match /content/{docName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ---- default: deny everything else ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

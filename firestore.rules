rules_version = '2';

// =====================================================================
//  Firestore Security Rules  —  Akay Mighty Concept
//  ---------------------------------------------------------------------
//  Public visitors can READ content (so the site renders).
//  Only the authenticated admin can WRITE.
//
//  Collections/documents covered:
//    content/images        — image slot overrides (img:logo, img:headshot, etc.)
//    content/texts         — text slot overrides
//    content/custom-images — admin-uploaded gallery images
//    content/projects      — dynamic Web Showcase projects (array of project objects)
//    content/_health       — write permission health check
//
//  All are covered by the wildcard match /content/{docName}.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- public read, admin-only write for all content ----
    match /content/{docName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ---- default: deny everything else ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
